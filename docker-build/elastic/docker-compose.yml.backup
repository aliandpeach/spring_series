services:
  spinfo-redis:
    container_name: spinfo-redis
    restart: always
    privileged: true
    image: spinfo-redis:6.2.7
    build:
      context: ./spinfo-redis
    networks:
      - spinfo-network
    ports:
      - "6379:6379"
    volumes:
      - ./spinfo-redis/conf/redis.conf:/home/spinfo/redis/redis.conf
      - ./spinfo-redis/data:/data
    command: redis-server /home/spinfo/redis/redis.conf
  spinfo-mysql:
    container_name: spinfo-mysql
    restart: always
    privileged: true
    image: bitnami/mysql:5.7.43
    networks:
      - spinfo-network
    ports:
      - "3306:3306"
    volumes:
      - ./spinfo-mysql/db:/docker-entrypoint-startdb.d/
      - ./spinfo-mysql/conf/my_custom.cnf:/opt/bitnami/mysql/conf/my_custom.cnf
      - ./spinfo-mysql/data:/bitnami/mysql/data
      - ./spinfo-mysql/logs:/bitnami/mysql/logs
    environment:
      MYSQL_ROOT_PASSWORD: ${MYSQL_PASSWORD}
      MYSQL_CHARACTER_SET: utf8mb4
      MYSQL_COLLATE: utf8mb4_general_ci
      TZ: Asia/Shanghai
  spinfo-nacos:
    container_name: spinfo-nacos
    restart: always
    privileged: true
    image: nacos/nacos-server:v2.4.0
    environment:
      - MODE=standalone
      - NACOS_AUTH_ENABLE=true
      - NACOS_AUTH_TOKEN="YWtkODkzNzY0ODk1Mzg3NDk4amtkaWV3a3Bsb2lkdWU="
      - NACOS_AUTH_IDENTITY_KEY="${NACOS_SERVER_USERNAME}"
      - NACOS_AUTH_IDENTITY_VALUE="${NACOS_SERVER_PASSWORD}"
      - SPRING_DATASOURCE_PLATFORM=mysql
      - MYSQL_SERVICE_HOST=${MYSQL_HOST}
      - MYSQL_SERVICE_PORT=${MYSQL_PORT}
      - MYSQL_SERVICE_DB_NAME=${MYSQL_NACOS_DATABASE}
      - MYSQL_SERVICE_USER=${MYSQL_USER}
      - MYSQL_SERVICE_PASSWORD=${MYSQL_PASSWORD}
      - JVM_XMS=512m
      - JVM_XMX=512m
      - JVM_XMN=256m
      - JVM_MS=64m
      - JVM_MMS=160m
    volumes:
      - ./spinfo-nacos/logs/:/home/nacos/logs
      - ./spinfo-nacos/data/:/home/nacos/data
      - ./spinfo-nacos/nacos_config.zip:/opt/data/nacos_config.zip
    networks:
      - spinfo-network
    expose:
      - 8848
      - 9848
      - 9849
    ports:
      - "8848:8848"
      - "9848:9848"
      - "9849:9849"
    depends_on:
      - spinfo-mysql
  spinfo-xxljob:
    container_name: spinfo-xxljob
    restart: always
    privileged: true
    image: xuxueli/xxl-job-admin:2.3.1-arm64
    environment:
      PARAMS: "--spring.datasource.url=jdbc:mysql://${MYSQL_HOST}:${MYSQL_PORT}/${MYSQL_XXLJOB_DATABASE}?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&serverTimezone=Asia/Shanghai&useSSL=false  --spring.datasource.username=${MYSQL_USER}  --spring.datasource.password=${MYSQL_PASSWORD}"
    networks:
      - spinfo-network
    ports:
      - "8080:8080"
    volumes:
      - ./spinfo-xxljob/logs/:/data/applogs/xxl-job/
    depends_on:
      - spinfo-mysql

  spinfo-es-single:
    image: docker.elastic.co/elasticsearch/elasticsearch:7.17.14-arm64
    container_name: spinfo-es-single
    restart: always
    privileged: true
    environment:
      - node.name=spinfo-es-single
      - cluster.name=es-docker-cluster
      - discovery.type=single-node
      - bootstrap.memory_lock=true
      - TAKE_FILE_OWNERSHIP=true
      - "ES_JAVA_OPTS=-Xms1024m -Xmx1024m"
      - xpack.security.enabled=true
      - ELASTIC_PASSWORD=${ES_PASSWORD}
      - xpack.security.transport.ssl.enabled=true
    ulimits:
      memlock:
        soft: -1
        hard: -1
    volumes:
      - ./spinfo-es-single/data:/usr/share/elasticsearch/data
      - ./spinfo-es-single/logs:/usr/share/elasticsearch/logs
      - ./spinfo-es-single/plugins:/usr/share/elasticsearch/plugins
      - ./spinfo-es-single/config/elasticsearch.yml:/usr/share/elasticsearch/config/elasticsearch.yml
    networks:
      - spinfo-network
    expose:
      - 9200
    ports:
      - "9200:9200"

      #  spinfo-es-head:
      #    image: wallbase/elasticsearch-head:6-alpine
      #    container_name: spinfo-es-head
      #    environment:
      #      TZ: 'Asia/Shanghai'
      #    networks:
      #      - spinfo-network
      #    ports:
      #      - '9210:9100'
      #    expose:
      #      - 9210
      #    depends_on:
      #      - spinfo-es-single

  spinfo-es-kibana:
    image: docker.elastic.co/kibana/kibana:7.17.14-arm64
    container_name: spinfo-es-kibana
    restart: always
    environment:
      - ES_HOST=${ES_HOST}
      - ES_PORT=${ES_PORT}
      - ES_USERNAME=${ES_USERNAME}
      - ES_PASSWORD=${ES_PASSWORD}
      - TZ='Asia/Shanghai'
    volumes:
      - ./spinfo-es-kibana/config/kibana.yml:/usr/share/kibana/config/kibana.yml
    networks:
      - spinfo-network
    expose:
      - 5601
    ports:
      - '5601:5601'
    depends_on:
      - spinfo-es-single

  spinfo-logstash:
    image: spinfo-logstash:7.17.9
    container_name: spinfo-logstash
    restart: always
    privileged: true
    build:
      context: ./spinfo-logstash
    environment:
      - ES_HOST=${ES_HOST}
      - ES_PORT=${ES_PORT}
      - ES_USERNAME=${ES_USERNAME}
      - ES_PASSWORD=${ES_PASSWORD}
      - MYSQL_HOST=${MYSQL_HOST}
      - MYSQL_PORT=${MYSQL_PORT}
      - MYSQL_USER=${MYSQL_USER}
      - MYSQL_PASSWORD=${MYSQL_PASSWORD}
      - MYSQL_UMP_CTF_DATABASE=${MYSQL_UMP_CTF_DATABASE}
      - TZ='Asia/Shanghai'
    volumes:
      - ./spinfo-logstash/config:/usr/share/logstash/config
      - ./spinfo-logstash/data:/usr/share/logstash/data
      - ./spinfo-logstash/lastId:/usr/share/logstash/lastId
      - ./spinfo-logstash/mysql-connect-java:/usr/share/logstash/mysql-connect-java
    networks:
      - spinfo-network
    ports:
      - '5044:5044'
      - '9600:9600'
    depends_on:
      - spinfo-es-single
      - spinfo-mysql

  spinfo-activemq:
    container_name: spinfo-activemq
    restart: always
    privileged: true
    image: spinfo-activemq:5.13.2
    build:
      context: ./spinfo-activemq
    networks:
      - spinfo-network
    ports:
      - "61617:61617"
      - "61612:61612"
      - "8161:8161"
    volumes:
      - ./spinfo-activemq/conf:/opt/Spinfo/apache-activemq/conf
      - ./spinfo-activemq/data:/opt/Spinfo/apache-activemq/data
      - ./spinfo-activemq/log:/opt/Spinfo/apache-activemq/log
    environment:
      ACTIVEMQ_ENABLED_AUTH: 'false'
      ACTIVEMQ_ENABLED_SCHEDULER: 'false'
      TZ: 'Asia/Shanghai'

  spinfo-mongo:
    container_name: spinfo-mongo
    restart: always
    privileged: true
    image: mongo:4.0.28
    networks:
      - spinfo-network
    ports:
      - "27018:27017"
    volumes:
      - ./spinfo-mongo/conf/mongod.conf.orig:/etc/mongod.conf.orig
      - ./spinfo-mongo/data:/data/db
      - ./spinfo-mongo/log:/var/log/mongodb
    environment:
      TZ: 'Asia/Shanghai'
      MONGO_INITDB_ROOT_USERNAME: root
      MONGO_INITDB_ROOT_PASSWORD: Spinfo0123
      wiredTigerCacheSizeGB: 2
    command: [
        '--auth'
    ]


#  python-env:
#    container_name: python-env
#    restart: always
#    image: python-env:1.0.0
#    build:
#      context: ./python-env
#    networks:
#      - spinfo-network
#    ports:
#      - "65432:65432"
#    volumes:
#      - ./spinfo-mongo/conf/mongod.conf.orig:/etc/mongod.conf.orig

networks:
  spinfo-network:
    name: spinfo-network
