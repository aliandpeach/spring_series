[client]
port=13306
socket=/var/run/mysqld/mysqld.sock
default-character-set=utf8mb4

[mysql]
default-character-set=utf8mb4

[mysqldump]
quick
max_allowed_packet=64M

[mysqld]
# ===== 基础 =====
port=13306
socket=/var/run/mysqld/mysqld.sock
pid-file=/var/run/mysqld/mysqld.pid
datadir=/var/lib/mysql

default-storage-engine=INNODB

# 字符集 (utf8mb4 替代 utf8,utf8 在 MySQL 中是 3 字节缺陷编码)
character-set-server=utf8mb4
collation-server=utf8mb4_general_ci
character-set-client-handshake=TRUE

# 大小写不敏感 (MySQL 8.0 必须在首次 init 前设定,init 后不可变更;
# 已在 docker-compose 的 command 里也声明一次,双保险)
lower_case_table_names=1

# 跳过主机名反查,加快客户端连接建立
skip-name-resolve=1

# ===== sql_mode (MySQL 8.0 合法值,去掉了已删除的 NO_AUTO_CREATE_USER) =====
sql_mode=STRICT_TRANS_TABLES,NO_ZERO_IN_DATE,NO_ZERO_DATE,ERROR_FOR_DIVISION_BY_ZERO,NO_ENGINE_SUBSTITUTION

# ===== 连接数与线程 =====
max_connections=500
max_user_connections=480
back_log=300
thread_cache_size=64
table_open_cache=4096
open_files_limit=65535

# ===== 超时 (合理值,避免 mysql_other 里 1 年那种连接泄漏) =====
wait_timeout=28800
interactive_timeout=28800
connect_timeout=20
net_read_timeout=30
net_write_timeout=60

# 包大小
max_allowed_packet=64M

# ===== InnoDB =====
# buffer_pool_size 建议按容器内存(2g)的 50~60% 取值
innodb_buffer_pool_size=1G
innodb_log_buffer_size=64M
innodb_log_file_size=256M
innodb_flush_log_at_trx_commit=1
innodb_file_per_table=1
innodb_lock_wait_timeout=120
innodb_read_io_threads=8
innodb_write_io_threads=8
innodb_io_capacity=1000

# ===== binlog (开启,便于增量备份/点位恢复) =====
server-id=1
log-bin=mysql-bin
binlog_format=ROW
binlog_row_image=MINIMAL
max_binlog_size=256M
expire_logs_days=7

# ===== 日志 =====
# 错误日志不指定 log_error,默认走 stderr,由 Docker 日志驱动接管
# (docker logs mysql8.0.13 即可查看),避免 bind mount 目录的属主权限问题。
# 慢查询日志不指定 slow_query_log_file,默认落在 datadir 下(/var/lib/mysql),
# 该目录 mysql 用户一定可写。如需集中收集,可改 log_output=TABLE 写到 mysql.slow_log 表。
slow_query_log=1
long_query_time=2
log_queries_not_using_indexes=0

# ===== 性能 schema (默认开启,排查用) =====
performance_schema=1
